{
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.mjs": {
      "includeFiles": ["autoencoder.onnx", "features.onnx", "model-card.json"],
      "excludeFiles": [
        "node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "node_modules/onnxruntime-node/bin/napi-v*/win32/**",
        "node_modules/onnxruntime-node/bin/napi-v*/linux/arm64/**"
      ],
      "maxDuration": 60
    }
  }
}
