{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{autoencoder.onnx,features.onnx,model-card.json}",
      "excludeFiles": "node_modules/onnxruntime-node/bin/napi-v*/{darwin,win32,linux/arm64}/**",
      "maxDuration": 60
    }
  }
}
